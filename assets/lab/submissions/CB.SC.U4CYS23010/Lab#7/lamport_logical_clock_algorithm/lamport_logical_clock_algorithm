class Node:
    def __init__(self, node_id):
        self.node_id = node_id
        self.clock = 0

    def event(self, event_id):
        self.clock += 1
        print(f"{self.node_id:<12}{event_id:<12}{'LOCAL':<12}{self.clock}")

    def send_message(self, destination, data, event_id):
        self.clock += 1

        packet = {
            "data": data,
            "source": self.node_id,
            "destination": destination.node_id,
            "time": self.clock
        }

        print(f"{self.node_id:<12}{event_id:<12}{'SEND':<12}{self.clock}")
        return packet

    def receive_message(self, packet, event_id):
        self.clock = max(self.clock, packet["time"]) + 1
        print(f"{self.node_id:<12}{event_id:<12}{'RECEIVE':<12}{self.clock}")


# Create three distributed nodes
node_a = Node("P1")
node_b = Node("P2")
node_c = Node("P3")

print("\nLAMPORT CLOCK SIMULATION")
print("=" * 46)
print(f"{'Process':<12}{'Event':<12}{'Operation':<12}{'Clock'}")
print("-" * 46)

# Events executed by the processes
node_a.event("E1")

packet_a = node_a.send_message(node_b, "m1", "E2")
node_b.receive_message(packet_a, "E3")

node_b.event("E4")

packet_b = node_b.send_message(node_c, "m2", "E5")

node_a.event("E6")

packet_c = node_a.send_message(node_c, "m3", "E7")

node_c.receive_message(packet_b, "E8")
node_c.receive_message(packet_c, "E9")

# Display the final logical clock values
print("-" * 46)
print("\nFINAL CLOCK VALUES")
print(f"Process P1: {node_a.clock}")
print(f"Process P2: {node_b.clock}")
print(f"Process P3: {node_c.clock}")

# Display the event ordering
print("\nCAUSAL ORDER")
print("E2 -> E3")
print("E3 -> E4")
print("E5 -> E8")
print("E7 -> E9")

print("\nCONCURRENT EVENTS")
print("E6 || E8")
print("E6 || E5")
print("E6 || E4")
print("E6 || E3")

print("=" * 46)
