FROM alpine:latest
RUN apk add --no-cache libc6-compat ca-certificates wget tar
ENV IPFS_VERSION=v0.36.0
RUN wget https://dist.ipfs.tech/kubo/${IPFS_VERSION}/kubo_${IPFS_VERSION}_linux-arm64.tar.gz \
    && tar -xvzf kubo_${IPFS_VERSION}_linux-arm64.tar.gz \
    && sh kubo/install.sh \
    && rm -rf kubo kubo_${IPFS_VERSION}_linux-arm64.tar.gz
ENV IPFS_PATH=/data/ipfs
RUN mkdir -p /data/ipfs
EXPOSE 4001 5001 8080
COPY wX2HsQmhDasBqVidFSvUsk-1920-80.jpg.webp /data/sample_image.png
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]